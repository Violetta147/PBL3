@model PBL3.ViewModel.Restaurant.RestaurantDetailViewModel
@using PBL3.Extensions
@{
    ViewData["Title"] = Model?.Name ?? "Chi tiết Nhà hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/restaurant-details.css" asp-append-version="true" />
    @* Link Leaflet CSS nếu dùng bản đồ *@
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

@if (Model == null)
{
    <div class="container mt-5">
        <div class="alert alert-danger text-center">
            <h4><i class="fas fa-exclamation-triangle"></i> Không tìm thấy thông tin</h4>
            <p>Rất tiếc, chúng tôi không thể tìm thấy nhà hàng bạn yêu cầu. Có thể nó đã bị xóa hoặc không tồn tại.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Quay lại Trang chủ</a>
        </div>
    </div>
    return;
}

<div class="restaurant-detail-container">
    @* HERO SECTION (ẢNH VÀ THÔNG TIN CƠ BẢN) *@
    <section class="restaurant-hero-section">
        <div class="restaurant-photos-grid">
            <div class="main-photo-container">
                <a href="@(!string.IsNullOrEmpty(Model.MainImageUrl) ? Model.MainImageUrl : "/images/placeholder-restaurant.png")"
                   data-toggle="lightbox" data-gallery="restaurant-hero-gallery" data-caption="@Model.Name">
                <img src="@(!string.IsNullOrEmpty(Model.MainImageUrl) ? Model.MainImageUrl : "/images/placeholder-restaurant.png")" alt="Ảnh chính của @Model.Name" />
                </a>
            </div>
            @if (Model.OtherImageUrls != null && Model.OtherImageUrls.Count > 0)
            {
                <div class="side-photos-container">
                    @foreach (var imageUrl in Model.OtherImageUrls.Take(2)) @* Hiển thị tối đa 2 ảnh phụ *@
                    {
                        <a href="@imageUrl" data-toggle="lightbox" data-gallery="restaurant-hero-gallery" data-caption="Ảnh khác của @Model.Name">
                            <img src="@imageUrl" alt="Ảnh khác của @Model.Name" />
                        </a>
                    }
                </div>
            }
             @if (Model.OtherImageUrls != null && Model.OtherImageUrls.Count > 2) @* Số ảnh thực tế là MainImage + OtherImages *@
            {
                <a href="#photos-tab-pane" class="photos-overlay-button">
                    <i class="fas fa-camera"></i> @(Model.OtherImageUrls.Count + (string.IsNullOrEmpty(Model.MainImageUrl) ? 0 : 1))+ ảnh
                </a>
            }
        </div>
        <div class="restaurant-header-info">
            <h1 class="restaurant-title">@Model.Name</h1>
            <div class="restaurant-meta-info">
                <div class="rating-stars-display">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(Model.AverageRating)) // Làm tròn để tô màu sao
                        {
                            <i class="fas fa-star"></i>
                        }
                        else if (i - 0.5 <= Model.AverageRating)
                        {
                            <i class="fas fa-star-half-alt"></i>
                        }
                        else
                        {
                            <i class="far fa-star"></i> @* Sao rỗng *@
                        }
                    }
                    <span class="rating-text ms-1">@Model.AverageRating.ToString("N1")</span>
                </div>
                <span class="review-count-text">(@Model.ReviewCount đánh giá)</span>
                <span class="mx-1">·</span>
                <span class="price-range-display">@Model.PriceRangeText</span>
                @if (Model.CuisineTypeNames.Any())
                {
                    <span class="mx-1">·</span>
                    <span class="cuisine-types-display">
                        @string.Join(", ", Model.CuisineTypeNames.Take(3)) @* Hiển thị tối đa 3 loại hình *@
                        @if(Model.CuisineTypeNames.Count > 3) { <text>...</text> }
                    </span>
                }
            </div>
             <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                <span class="status-badge @(Model.IsCurrentlyOpen ? "status-open" : (Model.CurrentOverallOpeningStatusText.Contains("Tạm") ? "status-temp-closed" : "status-closed"))">
                    <i class="@(Model.IsCurrentlyOpen ? "fas fa-door-open" : (Model.CurrentOverallOpeningStatusText.Contains("Tạm") ? "fas fa-pause-circle" : "fas fa-door-closed")) me-1"></i>
                    @Model.CurrentOverallOpeningStatusText
                </span>
                @if (Model.TagNames.Any())
                {
                    @foreach (var tag in Model.TagNames.Take(3)) // Hiển thị tối đa 3 tag
                    {
                        <span class="badge bg-light text-dark border">@tag</span>
                    }
                }
            </div>
             @if(User.Identity.IsAuthenticated)
            {
                 <a asp-controller="Reviews" asp-action="Create" asp-route-restaurantId="@Model.Id" class="btn btn-sm btn-outline-danger write-review-button mt-2">
                    <i class="fas fa-star"></i> Viết đánh giá
                </a>
            }
        </div>
    </section>

    @* MAIN CONTENT (TABS, LEFT COLUMN, RIGHT SIDEBAR) *@
    <div class="restaurant-main-content">
        @* LEFT COLUMN *@
        <div class="content-left-column">
            @* TABS NAVIGATION *@
            <ul class="nav nav-tabs mb-4" id="restaurantDetailTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="menu-tab" data-bs-toggle="tab" data-bs-target="#menu-tab-pane" type="button" role="tab" aria-controls="menu-tab-pane" aria-selected="true">Thực Đơn</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews-tab-pane" type="button" role="tab" aria-controls="reviews-tab-pane" aria-selected="false">Đánh Giá (@Model.ReviewCount)</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="photos-tab" data-bs-toggle="tab" data-bs-target="#photos-tab-pane" type="button" role="tab" aria-controls="photos-tab-pane" aria-selected="false">Hình Ảnh</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="info-tab" data-bs-toggle="tab" data-bs-target="#info-tab-pane" type="button" role="tab" aria-controls="info-tab-pane" aria-selected="false">Thông Tin</button>
                </li>
            </ul>

            @* TABS CONTENT *@
            <div class="tab-content" id="restaurantDetailTabsContent">
                @* TAB THỰC ĐƠN *@
                <div class="tab-pane fade show active" id="menu-tab-pane" role="tabpanel" aria-labelledby="menu-tab" tabindex="0">
                    <div class="section-card">
                         <h2 class="section-title">Thực Đơn</h2>
                        @if (Model.Menus != null && Model.Menus.Any())
                        {
                            foreach (var menu in Model.Menus) // Giả sử nhà hàng có thể có nhiều Menu (ví dụ: Menu Sáng, Tối)
                            {
                                @if (!string.IsNullOrWhiteSpace(menu.Title) && Model.Menus.Count > 1)
                                {
                                    <h3 class="menu-title-main">@menu.Title</h3>
                                }
                                @if (!string.IsNullOrWhiteSpace(menu.Description))
                                {
                                    <p class="text-muted"><em>@menu.Description</em></p>
                                }

                                @foreach (var section in menu.MenuSections)
                                {
                                    <h4 class="menu-section-title">@(section.Title)</h4>
                                    @if (!string.IsNullOrWhiteSpace(section.Description))
                                    {
                                        <p class="text-muted small">@(section.Description)</p>
                                    }
                                    @if (section.MenuItems.Any())
                                    {
                                        @foreach (var item in section.MenuItems)
                                        {
                                            <div class="menu-item-card">
                                                @if (!string.IsNullOrEmpty(item.MainImageUrl))
                                                {
                                                    <img src="@item.MainImageUrl" alt="@item.Name" class="menu-item-image-thumb" />
                                                }
                                                <div class="menu-item-details">
                                                    <div class="menu-item-name-price">
                                                        <span class="menu-item-name">
                                                            @item.Name
                                                            @if (item.IsSignatureDish)
                                                            {<span class="signature-badge ms-2">Đặc sắc</span>}
                                                        </span>
                                                        <span class="menu-item-price">@item.PriceDisplay</span>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(item.Description))
                                                    {
                                                        <p class="menu-item-description">@item.Description</p>
                                                    }
                                                    @if (item.CategoryNames.Any())
                                                    {
                                                        <p class="small text-muted menu-item-categories">
                                                            <em>@string.Join(" · ", item.CategoryNames)</em>
                                                        </p>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted fst-italic">Chưa có món ăn nào trong mục này.</p>
                                    }
                                }
                            }
                        }
                        else
                        {
                            <p class="text-muted">Nhà hàng hiện chưa cập nhật thực đơn.</p>
                        }
                    </div>
                </div>

                @* TAB ĐÁNH GIÁ *@
                <<div class="tab-pane fade" id="reviews-tab-pane" role="tabpanel" aria-labelledby="reviews-tab" tabindex="0">
                    <div class="section-card">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h2 class="section-title mb-0">Đánh giá & Nhận xét (@Model.ReviewCount lượt)</h2>
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <a asp-controller="Reviews" asp-action="Create" asp-route-restaurantId="@Model.Id" class="btn write-review-button btn-sm">
                                    <i class="fas fa-pencil-alt me-1"></i> Viết đánh giá của bạn
                                </a>
                            }
                            else
                            {
                                <a href="#" class="btn write-review-button btn-sm trigger-login-for-action"
                                   data-login-return-url="@Url.Action("Create", "Reviews", new { restaurantId = Model.Id })"
                                   data-action-description="viết đánh giá">
                                    <i class="fas fa-pencil-alt me-1"></i> Viết đánh giá
                                </a>
                            }
                        </div>

                        @if (Model.Reviews != null && Model.Reviews.Any())
                        {
                            foreach (var review in Model.Reviews)
                            {
                                <div class="review-item">
                                    <div class="review-user-info">
                                        <img src="@(review.UserAvatarUrl ?? "/images/avatars/default_avatar.png")" alt="@review.UserDisplayName" class="user-avatar-review" />
                                        <div>
                                            <div class="user-name-review">@review.UserDisplayName</div>
                                            <div class="review-date-text">Đã đánh giá vào: @review.ReviewDate.ToString("dd/MM/yyyy 'lúc' HH:mm")</div>
                                        </div>
                                    </div>
                                    <div class="review-rating-stars my-2">
                                        @* Thêm my-2 *@
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="fas fa-star @(i <= review.Rating ? "text-warning" : "text-muted opacity-50")"></i> @* Thêm opacity-50 cho sao rỗng *@
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(review.Comment))
                                    {
                                        <p class="review-comment-text">@Html.Raw(review.Comment?.Replace("\n", "<br />"))</p> @* Hiển thị xuống dòng *@
                                    }
                                    @if (review.PhotoUrls != null && review.PhotoUrls.Any())
                                    {
                                        <div class="review-photos-container mt-2">
                                            @foreach (var photoUrl in review.PhotoUrls)
                                            {
                                                <a href="@photoUrl" data-toggle="lightbox" data-gallery="review-photos-@review.Id" data-caption="Ảnh đánh giá của @review.UserDisplayName">
                                                    <img src="@photoUrl" class="review-photo-thumb" alt="Ảnh đính kèm đánh giá" />
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if (Model.ReviewCount > Model.Reviews.Count) // Nếu tổng số review nhiều hơn số review đang hiển thị
                            {
                                <div class="text-center mt-4">
                                    <a href="#" class="btn btn-outline-primary">Xem tất cả @Model.ReviewCount đánh giá</a>
                                    @* Link này sau này sẽ trỏ đến một trang riêng hoặc load thêm review bằng AJAX *@
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center p-4">
                                <i class="far fa-comment-dots fa-3x text-muted mb-3"></i>
                                <p class="text-muted">Chưa có đánh giá nào cho nhà hàng này. Hãy là người đầu tiên chia sẻ cảm nhận của bạn!</p>
                            </div>
                        }
                    </div>
                </div>

                @* TAB HÌNH ẢNH *@
                <div class="tab-pane fade" id="photos-tab-pane" role="tabpanel" aria-labelledby="photos-tab" tabindex="0">
                     <div class="section-card">
                        <h2 class="section-title">Thư viện ảnh</h2>
                        @if (Model.OtherImageUrls != null && Model.OtherImageUrls.Any())
                        {
                            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
                                @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                                {
                                    <div class="col">
                                        <a href="@Model.MainImageUrl" data-toggle="lightbox" data-gallery="restaurant-gallery-all" data-caption="Ảnh đại diện - @Model.Name">
                                            <img src="@Model.MainImageUrl" class="img-fluid rounded shadow-sm" alt="Ảnh đại diện @Model.Name" style="width:100%; height:200px; object-fit:cover;" />
                                        </a>
                                    </div>
                                }
                                @foreach (var imageUrl in Model.OtherImageUrls)
                                {
                                    <div class="col">
                                        <a href="@imageUrl" data-toggle="lightbox" data-gallery="restaurant-gallery-all" data-caption="Ảnh nhà hàng - @Model.Name">
                                            <img src="@imageUrl" class="img-fluid rounded shadow-sm" alt="Ảnh nhà hàng" style="width:100%; height:200px; object-fit:cover;" />
                                        </a>
                                    </div>
                                }
                            </div>
                        }
                        else if(!string.IsNullOrEmpty(Model.MainImageUrl)) // Chỉ có ảnh chính
                        {
                             <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
                                 <div class="col">
                                    <a href="@Model.MainImageUrl" data-toggle="lightbox" data-gallery="restaurant-gallery-all">
                                        <img src="@Model.MainImageUrl" class="img-fluid rounded shadow-sm" alt="Ảnh nhà hàng" style="width:100%; height:200px; object-fit:cover;"/>
                                    </a>
                                </div>
                             </div>
                        }
                        else
                        {
                            <p class="text-muted">Nhà hàng chưa cập nhật thư viện ảnh.</p>
                        }
                    </div>
                </div>
                
                @* TAB THÔNG TIN CHI TIẾT (GIỜ HOẠT ĐỘNG, MÔ TẢ, LIÊN HỆ) - Nằm trong cột trái *@
                <div class="tab-pane fade" id="info-tab-pane" role="tabpanel" aria-labelledby="info-tab" tabindex="0">
                    <div class="section-card">
                        <h2 class="section-title">Thông tin chi tiết</h2>
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <h5 class="mt-3">Giới thiệu</h5>
                            <p>@Html.Raw(Model.Description.Replace("\n", "<br />"))</p> @* Hiển thị xuống dòng nếu có *@
                        }

                        @if (Model.OperatingHoursGroupedByDay.Any(d => d.IsOpenToday))
                        {
                            <h5 class="mt-4">Giờ hoạt động</h5>
                            <div class="hours-list">
                                @foreach (var dayHours in Model.OperatingHoursGroupedByDay)
                                {
                                    <div class="day-group">
                                        <span class="day-name">@dayHours.DayDisplayName</span>
                                        <span class="@(dayHours.IsOpenToday ? "hours-text" : "hours-closed")">
                                            @if (dayHours.IsOpenToday && dayHours.TimeSlots.Any())
                                            {
                                                @string.Join(" & ", dayHours.TimeSlots)
                                            }
                                            else
                                            {
                                                <text>Đóng cửa</text>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                             <h5 class="mt-4">Giờ hoạt động</h5>
                             <p class="text-muted">Chưa cập nhật giờ hoạt động.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* RIGHT SIDEBAR *@
        <aside class="content-right-sidebar">
            <div class="section-card"> @* Bọc sidebar trong card cho nhất quán *@
                @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                {
                    <div id="mapDetailSidebar" class="map-sidebar-container"></div>
                }
                <div class="info-list mt-3">
                    <div class="info-item">
                        <i class="fas fa-map-marker-alt info-icon"></i>
                        <div>
                            <div class="info-label">Địa chỉ</div>
                            <div class="info-value">@Model.FullAddressText</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        <div class="info-item">
                            <i class="fas fa-phone-alt info-icon"></i>
                            <div>
                                <div class="info-label">Điện thoại</div>
                                <div class="info-value"><a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a></div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Website))
                    {
                        <div class="info-item">
                            <i class="fas fa-globe info-icon"></i>
                            <div>
                                <div class="info-label">Website</div>
                                <a href="@Model.Website" target="_blank" class="info-value" rel="noopener noreferrer">
                                    @Model.Website
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (Model.TagNames.Any())
            {
                <div class="section-card mt-4">
                    <h5 class="section-title" style="font-size:1.1rem; border-bottom: 1px solid #eee;">Tiện ích & Đặc điểm</h5>
                    <div class="mt-2">
                        @foreach (var tag in Model.TagNames)
                        {
                            <span class="badge bg-secondary bg-opacity-10 text-dark-emphasis fw-normal me-1 mb-1 p-2">@tag</span>
                        }
                    </div>
                </div>
            }
        </aside>
    </div>
</div>


@section Scripts {
    @* Script cho các thư viện ngoài (nếu chưa có trong _Layout.cshtml) *@
    @* <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script> *@

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Initialize Leaflet map cho sidebar (nếu có tọa độ)
        @if (Model != null && Model.Latitude.HasValue && Model.Longitude.HasValue)
        {
            // Sử dụng CultureInfo.InvariantCulture để đảm bảo dấu . cho số thập phân
            var latSidebar = @Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var lonSidebar = @Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);

            <text>
                    if (document.getElementById('mapDetailSidebar')) {
                        try {
                            var mapSidebar = L.map('mapDetailSidebar').setView([latSidebar, lonSidebar], 16);
                            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                                attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                            }).addTo(mapSidebar);
                            L.marker([latSidebar, lonSidebar]).addTo(mapSidebar)
                                .bindPopup('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.Name))');
                        } catch (e) {
                            console.error("Lỗi khởi tạo bản đồ Leaflet trong sidebar:", e);
                        }
                    }
            </text>
        }

            // bs5-lightbox thường tự động kích hoạt với data-bs-toggle="lightbox".
            // Nếu bạn dùng thư viện lightbox khác, có thể cần code khởi tạo ở đây.
            // Ví dụ, nếu dùng ekko-lightbox (thư viện cũ hơn):
            // $(document).on('click', '[data-toggle="lightbox"]', function(event) {
            //     event.preventDefault();
            //     $(this).ekkoLightbox();
            // });
        });
    </script>
}