@model PBL3.ViewModel.DirectionsViewModel
@{
    ViewData["Title"] = "Chỉ đường";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h2>Chỉ đường đến @(Model.LocationName ?? "địa điểm")</h2>
            
            @if (!string.IsNullOrEmpty(Model.LocationAddress))
            {
                <p class="text-muted"><i class="fas fa-map-marker-alt"></i> @Model.LocationAddress</p>
            }
        </div>
    </div>

    <div class="row mt-3">
        <!-- Bản đồ -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-map"></i> Bản đồ chỉ đường</h5>
                </div>
                <div class="card-body p-0">
                    <div id="directionsMap" style="height: 500px; width: 100%;"></div>
                </div>
            </div>
        </div>

        <!-- Panel điều khiển -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-route"></i> Thông tin chỉ đường</h5>
                </div>
                <div class="card-body">
                    <!-- Vị trí hiện tại -->
                    <div class="mb-3">
                        <label class="form-label">Vị trí hiện tại của bạn:</label>
                        <div id="currentLocation" class="text-muted">
                            <i class="fas fa-spinner fa-spin"></i> Đang xác định vị trí...
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="getCurrentLocation()">
                            <i class="fas fa-crosshairs"></i> Lấy vị trí hiện tại
                        </button>
                    </div>

                    <!-- Điểm đến -->
                    <div class="mb-3">
                        <label class="form-label">Điểm đến:</label>
                        <div class="bg-light p-2 rounded">
                            <strong>@(Model.LocationName ?? "Địa điểm")</strong><br>
                            <small class="text-muted">
                                Tọa độ: @Model.Latitude.ToString("F6"), @Model.Longitude.ToString("F6")
                            </small>
                        </div>
                    </div>

                    <!-- Nút chỉ đường -->
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-primary" onclick="calculateDirections()">
                            <i class="fas fa-route"></i> Tính chỉ đường
                        </button>
                        <button type="button" class="btn btn-success" onclick="openGoogleMaps()">
                            <i class="fab fa-google"></i> Mở Google Maps
                        </button>
                        @* Nút Apple Maps đã được comment *@
                    </div>

                    <!-- Thông tin chỉ đường -->
                    <div id="directionsInfo" class="mt-3" style="display: none;">
                        <hr>
                        <h6>Thông tin tuyến đường:</h6>
                        <div id="routeDetails"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* CSS của bạn giữ nguyên */
    .directions-step {
        padding: 8px;
        border-left: 3px solid #007bff;
        margin-bottom: 5px;
        background-color: #f8f9fa;
    }
    
    .route-summary {
        background-color: #e3f2fd;
        padding: 10px;
        border-radius: 5px;
        margin-bottom: 15px;
    }
</style>
@section Scripts {
    <!-- The order of these scripts is CRITICAL. Do not change it. -->

    <!-- 1. Leaflet Core Library (CSS and JS) - This creates the 'L' object. -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- 2. Leaflet Routing Machine Library (CSS and JS) - This needs 'L' to exist. -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css" />
    <script src="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js"></script>

    <!-- 3. The Mapbox Plugin - This needs L.Routing to exist. -->
    <script src="https://unpkg.com/lrm-mapbox@1.0.4/dist/lrm-mapbox.js"></script>

    <!-- 4. Your Custom Code - This runs last and uses all the tools above. -->
    <script>
        var map;
        var userMarker;
        var destinationMarker;
        var routingControl;
        
        var destinationLat = @Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var destinationLon = @Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var userLat, userLon;
        
        var mapboxAccessToken = '@Html.Raw(ViewBag.MapboxToken ?? "")';

        document.addEventListener('DOMContentLoaded', function() {
            if (!mapboxAccessToken) {
                console.error('Mapbox Access Token is missing!');
                alert('Lỗi cấu hình: Không tìm thấy Mapbox Access Token.');
                return;
            }
            initializeMap();
            getCurrentLocation();
        });

        function initializeMap() {
            map = L.map('directionsMap').setView([destinationLat, destinationLon], 13);
            
            L.tileLayer('https://api.mapbox.com/styles/v1/{id}/tiles/{z}/{x}/{y}?access_token={accessToken}', {
                attribution: '© <a href="https://www.mapbox.com/about/maps/">Mapbox</a> © <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                id: 'mapbox/streets-v11',
                accessToken: mapboxAccessToken
            }).addTo(map);

            destinationMarker = L.marker([destinationLat, destinationLon], {
                icon: L.icon({
                    iconUrl: 'https://cdn.rawgit.com/pointhi/leaflet-color-markers/master/img/marker-icon-red.png',
                    shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                    iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34], shadowSize: [41, 41]
                })
            }).addTo(map)
            .bindPopup('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.LocationName ?? "Điểm đến"))');
        }

        function getCurrentLocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function(position) {
                    userLat = position.coords.latitude;
                    userLon = position.coords.longitude;
                    document.getElementById('currentLocation').innerHTML = `<i class="fas fa-map-marker-alt text-success"></i> Latitude: ${userLat.toFixed(6)}, Long: ${userLon.toFixed(6)}`;
                    if (userMarker) map.removeLayer(userMarker);
                    userMarker = L.marker([userLat, userLon], {
                        icon: L.icon({
                            iconUrl: 'https://cdn.rawgit.com/pointhi/leaflet-color-markers/master/img/marker-icon-blue.png',
                            shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                            iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34], shadowSize: [41, 41]
                        })
                    }).addTo(map).bindPopup('Vị trí của bạn');
                    var group = new L.featureGroup([userMarker, destinationMarker]);
                    map.fitBounds(group.getBounds().pad(0.5));
                }, function(error) {
                    document.getElementById('currentLocation').innerHTML = '<i class="fas fa-exclamation-triangle text-warning"></i> Không thể xác định vị trí';
                });
            }
        }

        function calculateDirections() {
            if (!userLat || !userLon) {
                alert('Vui lòng cho phép truy cập vị trí');
                return;
            }
            if (routingControl) map.removeControl(routingControl);
            
            const routeDetailsEl = document.getElementById('routeDetails');
            document.getElementById('directionsInfo').style.display = 'block';
            routeDetailsEl.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang tìm đường đi...';

            routingControl = L.Routing.control({
                waypoints: [ L.latLng(userLat, userLon), L.latLng(destinationLat, destinationLon) ],
                router: L.Routing.mapbox(mapboxAccessToken, { profile: 'mapbox/driving-traffic', language: 'vi' }),
                createMarker: function() { return null; },
                addWaypoints: false,
                routeWhileDragging: false
            }).on('routesfound', function(e) {
                var summary = e.routes[0].summary;
                routeDetailsEl.innerHTML = `<div class="route-summary"><strong>Khoảng cách:</strong> ${(summary.totalDistance / 1000).toFixed(1)} km<br><strong>Thời gian:</strong> ${Math.round(summary.totalTime / 60)} phút</div>`;
            }).on('routingerror', function(e) {
                routeDetailsEl.innerHTML = `<div class="alert alert-danger">Lỗi: ${e.error.message}</div>`;
            }).addTo(map);
        }

        function openGoogleMaps() {
            var url = (userLat && userLon) ? `https://www.google.com/maps/dir/${userLat},${userLon}/${destinationLat},${destinationLon}` : `https://www.google.com/maps/dir/?api=1&destination=${destinationLat},${destinationLon}`;
            window.open(url, '_blank');
        }
    </script>
}