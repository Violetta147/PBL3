@* Views/AdminRestaurant/Index.cshtml (hoặc Areas/Admin/Views/AdminRestaurant/Index.cshtml) *@
@model PBL3.Models.Common.PagedResult<PBL3.ViewModel.Admin.AdminRestaurantListItemViewModel>
@using PBL3.Models
@using PBL3.Extensions
@{
    Layout = "_AdminLayout"; // Sử dụng Admin Layout
    ViewData["Title"] = "Quản lý Nhà hàng";

    // Lấy lại các giá trị filter để hiển thị lại trên form
    string currentSearchTerm = ViewData["CurrentSearchTerm"] as string ?? "";
    string currentStatusFilter = ViewData["CurrentStatusFilter"] as string ?? "";
    string currentOwnerSearch = ViewData["CurrentOwnerSearch"] as string ?? "";
    string currentSortBy = ViewData["CurrentSortBy"] as string ?? "createdat_desc";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">@ViewData["Title"]</h1>
    @* <a asp-action="Create" class="btn btn-sm btn-outline-primary"><i class="fas fa-plus-circle"></i> Thêm nhà hàng mới</a> *@
</div>

@if (TempData["SuccessMessage"] != null)
{
        <div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["ErrorMessage"] != null)
{
        <div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<form asp-action="Index" method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-4">
            <input type="text" name="searchTerm" value="@currentSearchTerm" class="form-control form-control-sm" placeholder="Tìm tên/mô tả nhà hàng..." />
        </div>
        <div class="col-md-3">
            <input type="text" name="ownerSearchTerm" value="@currentOwnerSearch" class="form-control form-control-sm" placeholder="Tìm theo chủ sở hữu..." />
        </div>
        <div class="col-md-2">
            <select name="statusFilter" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<RestaurantStatus>()">
                <option value="">Tất cả trạng thái</option>
            </select>
        </div>
        <div class="col-md-2">
             <select name="sortBy" class="form-select form-select-sm">
                <option value="createdat_desc" selected="@(currentSortBy == "createdat_desc")">Mới nhất</option>
                <option value="name_asc" selected="@(currentSortBy == "name_asc")">Tên A-Z</option>
                <option value="owner_asc" selected="@(currentSortBy == "owner_asc")">Chủ sở hữu A-Z</option>
                <option value="status_asc" selected="@(currentSortBy == "status_asc")">Trạng thái</option>
            </select>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary btn-sm w-100"><i class="fas fa-filter"></i> Lọc</button>
        </div>
    </div>
</form>

@if (Model != null && Model.Items.Any())
{
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered table-sm align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Tên Nhà Hàng</th>
                        <th>Chủ Sở Hữu</th>
                        <th>Địa chỉ</th>
                        <th>Trạng Thái</th>
                        <th>Ngày Tạo</th>
                        <th>Đ.Giá TB</th>
                        <th>Lượt ĐG</th>
                        <th style="width: 200px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Items)
                {
                            <tr>
                                <td>@r.Id</td>
                                <td>
                                    <a href="@r.ViewDetailsUrl" target="_blank">@r.Name</a>
                            @if (!string.IsNullOrEmpty(r.MainImageUrl))
                            {
                                            <a href="@r.MainImageUrl" data-bs-toggle="lightbox" data-gallery="admin-resto-gallery" data-title="@r.Name">
                                                <i class="fas fa-image ms-1 text-secondary" title="Xem ảnh đại diện"></i>
                                            </a>
                            }
                                </td>
                                <td>@r.OwnerDisplayName (@r.OwnerEmail)</td>
                                <td class="small">@r.FullAddressText</td>
                                <td>
                                    <span class="badge @(r.Status == RestaurantStatus.Open ? "bg-success" : (r.Status == RestaurantStatus.TemporarilyClosed ? "bg-warning text-dark" : "bg-danger"))">
                                @r.Status.ToVietnameseRestaurantStatus()
                                    </span>
                                </td>
                                <td>@r.CreatedAt.ToString("g")</td>
                                <td>@r.AverageRating.ToString("N1") <i class="fas fa-star text-warning"></i></td>
                                <td>@r.ReviewCount</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                @if (r.Status != RestaurantStatus.Open)
                                {
                                                <form asp-action="Approve" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('Duyệt và mở cửa nhà hàng này?');">
                                        @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-success" title="Duyệt"><i class="fas fa-check-circle"></i></button>
                                                </form>
                                }
                                @if (r.Status == RestaurantStatus.Open)
                                {
                                                <form asp-action="Suspend" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('Tạm ngưng nhà hàng này?');">
                                        @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-warning" title="Tạm ngưng"><i class="fas fa-pause-circle"></i></button>
                                                </form>
                                }
                                else if (r.Status == RestaurantStatus.TemporarilyClosed)
                                {
                                                 <form asp-action="Unsuspend" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('Mở lại nhà hàng này?');">
                                        @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-info" title="Mở lại"><i class="fas fa-play-circle"></i></button>
                                                </form>
                                }
                                        <a asp-controller="Business" asp-action="ManageMenu" asp-route-restaurantId="@r.Id" class="btn btn-outline-secondary" title="Quản lý Menu"><i class="fas fa-utensils"></i></a>
                                        <a href="@r.EditRestaurantUrl" class="btn btn-outline-primary" title="Sửa thông tin"><i class="fas fa-edit"></i></a>
                                @* Nút Xóa cần cẩn thận, có thể thêm sau với xác nhận mạnh hơn *@
                                @* <form asp-action="DeleteRestaurantAsAdmin" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('XÓA VĨNH VIỄN nhà hàng này và tất cả dữ liệu liên quan? Hành động này KHÔNG THỂ hoàn tác!');">@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-danger" title="Xóa"><i class="fas fa-trash-alt"></i></button></form> *@
                                    </div>
                                </td>
                            </tr>
                }
                </tbody>
            </table>
        </div>

    @* Phân trang *@
    @* ... (Copy phần phân trang từ AdminUser/Index.cshtml, thay asp-action="Index" và các asp-route-* cho đúng) ... *@
        <nav aria-label="Restaurant list navigation">
            <ul class="pagination justify-content-center mt-4">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item"><a class="page-link" asp-action="Index" asp-route-searchTerm="@currentSearchTerm" asp-route-statusFilter="@currentStatusFilter" asp-route-ownerSearchTerm="@currentOwnerSearch" asp-route-sortBy="@currentSortBy" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">Trước</a></li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">Trước</span></li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-searchTerm="@currentSearchTerm" asp-route-statusFilter="@currentStatusFilter" asp-route-ownerSearchTerm="@currentOwnerSearch" asp-route-sortBy="@currentSortBy" asp-route-pageNumber="@i" asp-route-pageSize="@Model.PageSize">@i</a></li>
            }

            @if (Model.HasNextPage)
            {
                <li class="page-item"><a class="page-link" asp-action="Index" asp-route-searchTerm="@currentSearchTerm" asp-route-statusFilter="@currentStatusFilter" asp-route-ownerSearchTerm="@currentOwnerSearch" asp-route-sortBy="@currentSortBy" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">Sau</a></li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">Sau</span></li>
            }
            </ul>
        </nav>
}
else
{
        <div class="alert alert-info mt-3">Không tìm thấy nhà hàng nào phù hợp với tiêu chí của bạn.</div>
}

@section Scripts {
    @* Thêm bs5-lightbox JS nếu bạn dùng data-bs-toggle="lightbox" cho ảnh *@
        <script src="https://cdn.jsdelivr.net/npm/bs5-lightbox@1.8.3/dist/bs5-lightbox.min.js"></script>
        <script>
            // Giữ lại các hàm global message nếu bạn đã định nghĩa chúng ở đâu đó
            // function showGlobalSuccessMessage(message) { ... }
            // function showGlobalErrorMessage(message) { ... }
            // function escapeHtml(unsafe) { ... }

            // $(document).ready(function() {
            //     // Logic JS nếu cần, ví dụ: khởi tạo lại lightbox sau khi lọc
            // });
        </script>
}