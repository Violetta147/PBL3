@model PBL3.Models.Common.PagedResult<PBL3.ViewModel.Restaurant.RestaurantListItemViewModel>
@{
    ViewData["Title"] = "Chọn Nhà hàng để Đánh giá";
}

<div class="container mt-4 mb-5">
    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold">@ViewData["Title"]</h1>
        <p class="lead text-muted">Tìm kiếm và chọn nhà hàng bạn muốn chia sẻ cảm nhận.</p>
    </div>

    @* Form tìm kiếm nhà hàng *@
    <form asp-action="SelectRestaurantForReview" asp-controller="Reviews" method="get" class="mb-4">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="input-group input-group-lg">
                    <input type="text" name="searchTerm" value="@ViewData["SearchTerm"]" class="form-control" placeholder="Nhập tên nhà hàng..." aria-label="Tìm kiếm nhà hàng">
                    <button class="btn btn-primary" type="submit"><i class="fas fa-search"></i> Tìm</button>
                </div>
            </div>
        </div>
    </form>

    @if (Model != null && Model.Items.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var restaurant in Model.Items)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm restaurant-select-card">
                        @if (!string.IsNullOrEmpty(restaurant.MainImageUrl))
                        {
                            <img src="@restaurant.MainImageUrl" class="card-img-top" alt="@restaurant.Name" style="height: 180px; object-fit: cover;">
                        }
                        else
                        {
                            <img src="/images/placeholder-restaurant.png" class="card-img-top" alt="Ảnh mặc định" style="height: 180px; object-fit: cover;">
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@restaurant.Name</h5>
                            @if (!string.IsNullOrEmpty(restaurant.ShortAddress))
                            {
                                <p class="card-text text-muted small mb-2"><i class="fas fa-map-marker-alt fa-fw me-1"></i>@restaurant.ShortAddress</p>
                            }
                            <div class="mt-auto text-center">
                                <a asp-controller="Reviews" asp-action="Create" asp-route-restaurantId="@restaurant.Id" class="btn btn-success btn-sm w-100">
                                    <i class="fas fa-pencil-alt me-1"></i> Viết đánh giá cho quán này
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Phân trang *@
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Trang chọn nhà hàng" class="mt-5">
                <ul class="pagination justify-content-center">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="SelectRestaurantForReview" asp-route-searchTerm="@ViewData["SearchTerm"]" asp-route-pageNumber="@(Model.PageNumber - 1)">Trước</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">Trước</span></li>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="SelectRestaurantForReview" asp-route-searchTerm="@ViewData["SearchTerm"]" asp-route-pageNumber="@i">@i</a>
                        </li>
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="SelectRestaurantForReview" asp-route-searchTerm="@ViewData["SearchTerm"]" asp-route-pageNumber="@(Model.PageNumber + 1)">Sau</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">Sau</span></li>
                    }
                </ul>
            </nav>
        }
    }
    else if (!string.IsNullOrEmpty((string?)ViewData["SearchTerm"])) // Có tìm kiếm nhưng không có kết quả
    {
        <div class="alert alert-warning text-center mt-4" role="alert">
            <i class="fas fa-search fa-2x mb-2"></i><br />
            Không tìm thấy nhà hàng nào phù hợp với từ khóa "<strong>@ViewData["SearchTerm"]</strong>".
        </div>
    }
    else // Chưa tìm kiếm và cũng không có nhà hàng nào mặc định (ít khả thi nếu DB có dữ liệu)
    {
        <div class="alert alert-info text-center mt-4" role="alert">
            Hãy nhập tên nhà hàng bạn muốn đánh giá vào ô tìm kiếm phía trên.
        </div>
    }
</div>

@section Styles {
    <style>
        .restaurant-select-card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }

            .restaurant-select-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15) !important;
            }
    </style>
}