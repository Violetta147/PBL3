@model X.PagedList.IPagedList<PBL3.ViewModel.RestaurantCardViewModel>
@{
    ViewData["Title"] = "Chọn Nhà hàng để Đánh giá";
}

<div class="container mt-4 mb-5">
    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold">@ViewData["Title"]</h1>
        <p class="lead text-muted">Tìm kiếm và chọn nhà hàng bạn muốn chia sẻ cảm nhận.</p>
    </div>

    @* Restaurant Search with Dropdown *@
    <div class="row justify-content-center mb-4">
        <div class="col-md-8 col-lg-6">
            <div class="position-relative">
                <div class="input-group input-group-lg">
                    <input type="text" id="restaurant-search" class="form-control" placeholder="Nhập tên nhà hàng..." aria-label="Tìm kiếm nhà hàng" autocomplete="off">
                    <button class="btn btn-primary" type="button" id="search-btn"><i class="fas fa-search"></i> Tìm</button>
                </div>
                <div id="search-dropdown" class="dropdown-menu w-100" style="max-height: 300px; overflow-y: auto; display: none;">
                    <!-- Dropdown items will be populated here -->
                </div>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var restaurant in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm restaurant-select-card">
                        @if (!string.IsNullOrEmpty(restaurant.CardImageUrl))
                        {
                            <img src="@restaurant.CardImageUrl" class="card-img-top" alt="@restaurant.Name" style="height: 180px; object-fit: cover;">
                        }
                        else
                        {
                            <img src="/images/placeholder-restaurant.png" class="card-img-top" alt="Ảnh mặc định" style="height: 180px; object-fit: cover;">
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@restaurant.Name</h5>
                            @if (!string.IsNullOrEmpty(restaurant.FullAddress))
                            {
                                <p class="card-text text-muted small mb-2"><i class="fas fa-map-marker-alt fa-fw me-1"></i>@restaurant.FullAddress</p>
                            }
                            @if (restaurant.CuisineSummary != null && restaurant.CuisineSummary.Any())
                            {
                                <p class="card-text text-muted small mb-2">
                                    <i class="fas fa-utensils fa-fw me-1"></i>@string.Join(", ", restaurant.CuisineSummary.Where(c => !string.IsNullOrEmpty(c)))
                                </p>
                            }
                            @if (restaurant.AverageRating > 0)
                            {
                                <div class="d-flex align-items-center mb-2">
                                    <span class="text-warning me-1">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= restaurant.AverageRating)
                                            {
                                                <i class="fas fa-star"></i>
                                            }
                                            else if (i - 0.5 <= restaurant.AverageRating)
                                            {
                                                <i class="fas fa-star-half-alt"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star"></i>
                                            }
                                        }
                                    </span>
                                    <span class="text-muted small">(@(restaurant.ReviewCount) đánh giá)</span>
                                </div>
                            }
                            <div class="mt-auto text-center">
                                <a asp-controller="Reviews" asp-action="Create" asp-route-restaurantId="@restaurant.Id" class="btn btn-success btn-sm w-100">
                                    <i class="fas fa-pencil-alt me-1"></i> Viết đánh giá cho quán này
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Pagination *@
        @if (Model.PageCount > 1)
        {
            <nav aria-label="Trang chọn nhà hàng" class="mt-5">
                <ul class="pagination justify-content-center">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="SelectRestaurantForReview" asp-route-searchTerm="@ViewData["SearchTerm"]" asp-route-pageNumber="@(Model.PageNumber - 1)">Trước</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">Trước</span></li>
                    }

                    @for (int i = 1; i <= Model.PageCount; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="SelectRestaurantForReview" asp-route-searchTerm="@ViewData["SearchTerm"]" asp-route-pageNumber="@i">@i</a>
                        </li>
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="SelectRestaurantForReview" asp-route-searchTerm="@ViewData["SearchTerm"]" asp-route-pageNumber="@(Model.PageNumber + 1)">Sau</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">Sau</span></li>
                    }
                </ul>
            </nav>
        }
    }
    else if (!string.IsNullOrEmpty((string?)ViewData["SearchTerm"])) 
    {
        <div class="alert alert-warning text-center mt-4" role="alert">
            <i class="fas fa-search fa-2x mb-2"></i><br />
            Không tìm thấy nhà hàng nào phù hợp với từ khóa "<strong>@ViewData["SearchTerm"]</strong>".
        </div>
    }
    else 
    {
        <div class="alert alert-info text-center mt-4" role="alert">
            Hãy nhập tên nhà hàng bạn muốn đánh giá vào ô tìm kiếm phía trên.
        </div>
    }
</div>

@section Styles {
    <style>
        .restaurant-select-card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }

        .restaurant-select-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15) !important;
        }

        #search-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            z-index: 1000;
            border: 1px solid #ccc;
            border-radius: 0.375rem;
            background-color: white;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15);
        }

        .dropdown-item:hover {
            background-color: #f8f9fa;
        }

        .dropdown-item {
            padding: 0.75rem 1rem;
            cursor: pointer;
            border-bottom: 1px solid #eee;
        }

        .dropdown-item:last-child {
            border-bottom: none;
        }

        .restaurant-suggestion {
            display: flex;
            align-items: center;
        }

        .restaurant-suggestion img {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 0.25rem;
            margin-right: 0.75rem;
        }

        .restaurant-info h6 {
            margin: 0;
            font-weight: 600;
        }

        .restaurant-info small {
            color: #6c757d;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            let searchTimeout;
            const searchInput = $('#restaurant-search');
            const searchDropdown = $('#search-dropdown');
            const searchBtn = $('#search-btn');

            // Handle search input with debounce
            searchInput.on('input', function() {
                clearTimeout(searchTimeout);
                const query = $(this).val().trim();

                if (query.length >= 2) {
                    searchTimeout = setTimeout(() => {
                        searchRestaurants(query);
                    }, 300);
                } else {
                    hideDropdown();
                }
            });

            // Handle search button click
            searchBtn.on('click', function() {
                const query = searchInput.val().trim();
                if (query) {
                    window.location.href = '@Url.Action("SelectRestaurantForReview", "Reviews")?searchTerm=' + encodeURIComponent(query);
                }
            });

            // Handle Enter key
            searchInput.on('keypress', function(e) {
                if (e.which === 13) {
                    searchBtn.click();
                }
            });

            // Hide dropdown when clicking outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('.position-relative').length) {
                    hideDropdown();
                }
            });

            function searchRestaurants(query) {
                $.ajax({
                    url: '@Url.Action("SearchRestaurantSuggestions", "Reviews")',
                    type: 'GET',
                    data: { query: query },
                    success: function(data) {
                        displayDropdown(data);
                    },
                    error: function() {
                        hideDropdown();
                    }
                });
            }

            function displayDropdown(restaurants) {
                if (restaurants && restaurants.length > 0) {
                    let html = '';
                    restaurants.forEach(function(restaurant) {
                        const imageUrl = restaurant.cardImageUrl || '/images/placeholder-restaurant.png';
                        html += `
                            <div class="dropdown-item" data-restaurant-id="${restaurant.id}">
                                <div class="restaurant-suggestion">
                                    <img src="${imageUrl}" alt="${restaurant.name}">
                                    <div class="restaurant-info">
                                        <h6>${restaurant.name}</h6>
                                        <small>${restaurant.fullAddress || ''}</small>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                    searchDropdown.html(html).show();

                    // Handle dropdown item click
                    $('.dropdown-item').on('click', function() {
                        const restaurantId = $(this).data('restaurant-id');
                        window.location.href = '@Url.Action("Create", "Reviews")?restaurantId=' + restaurantId;
                    });
                } else {
                    hideDropdown();
                }
            }

            function hideDropdown() {
                searchDropdown.hide();
            }
        });
    </script>
}